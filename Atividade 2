class Produto:
    def __init__(self, nome, preco, quantidade_estoque):
        self.nome = nome
        self.preco = preco
        self.quantidade_estoque = quantidade_estoque

    def valor_total_estoque(Produto):
        return Produto.quantidade_estoque * Produto.preco

coca = Produto("Coca-Cola", 9.99, 2001)
print(coca.valor_total_estoque())
